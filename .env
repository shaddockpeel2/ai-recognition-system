# 启用 ZLMediaKit 作为统一视频接入/代理网关
SAFEHAT_ZLM_ENABLED=1
# ZLM HTTP API 地址
SAFEHAT_ZLM_API_BASE=http://127.0.0.1:8080
# ZLM API 鉴权 secret，需和 config.ini 一致
SAFEHAT_ZLM_SECRET=eECYnFPVN66GI3b0g7mvXNtSF5rkR4xk
# ZLM 对外/内部 RTSP 端口，算法默认拉这个端口的统一流
SAFEHAT_ZLM_RTSP_PORT=8554
# ZLM HTTP/HTTP-FLV/API 端口
SAFEHAT_ZLM_HTTP_PORT=8080
# 当前 ZLM 同时给 WVP/GB28181 使用，普通摄像头/视频流默认直连原始地址，避免被 WVP hook 鉴权拦截
SAFEHAT_ZLM_APP_PROXY_ENABLED=0
SAFEHAT_ZLM_FORCE_GATEWAY=0
SAFEHAT_ZLM_DEFAULT_GATEWAY=0
# WVP 使用项目内 JDK，避免系统 PATH 没有 java 导致启动失败
SAFEHAT_WVP_JAVA_BIN=/home/admin/Desktop/safehat/jdk-21.0.11/bin/java
# WVP Java 服务启动较慢，GB28181 设备列表请求前等待它完成启动
SAFEHAT_WVP_STARTUP_TIMEOUT=180
# GB28181 摄像头注册到当前 RK3568 开发板，传输协议保持 UDP
SAFEHAT_GB_SIP_SERVER_IP=192.168.1.17
SAFEHAT_GB_SIP_SERVER_PORT=15060
SAFEHAT_GB_SIP_SERVER_ID=34020000002000000001
SAFEHAT_GB_SIP_DOMAIN=3402000000
SAFEHAT_GB_SIP_PASSWORD=safehat123456
SAFEHAT_GB_TRANSPORT=UDP
# 关闭 MPP/GStreamer 硬解码，使用 OpenCV/FFmpeg 低延迟路径
# GStreamer pipeline 的 latency=80 缓冲对低帧率摄像头反而增加延迟
SAFEHAT_MPP_DECODE_ENABLED=0
# 关闭算法处理结果推回 ZLM，避免推流管线异常拖死开发板
SAFEHAT_PUSH_PROCESSED_ENABLED=0
